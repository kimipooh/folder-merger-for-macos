    "Shooting information (such as EXIF) embedded in Takeout photos and videos, and accompanying JSON files, are copied as file contents regardless of these settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shooting information (such as EXIF) embedded in Takeout photos and videos, and accompanying JSON files, are copied as file contents regardless of these settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Takeoutの写真・動画に埋め込まれた撮影情報（EXIF等）や付属JSONは、チェック状態にかかわらずファイルの内容としてコピーされます。"
          }
        }
      },
      "generatesSymbol": false
    },
