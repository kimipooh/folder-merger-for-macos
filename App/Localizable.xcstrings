    "Keeps Finder tags and additional data used by some Mac files. Leave this on for normal use.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps Finder tags and additional data used by some Mac files. Leave this on for normal use."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderで付けたタグや、一部のMac用ファイルに付属するデータを引き継ぎます。通常はオンのままで使えます。"
          }
        }
      },
      "generatesSymbol": false
    },
    "Keeps the original file dates shown in Finder.": {
      "extractionState": "manual",
