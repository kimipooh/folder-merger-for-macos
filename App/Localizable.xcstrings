    "If the destination does not support an attribute, the warning shows the affected path and attribute, and the result is “Completed with warnings”.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the destination does not support an attribute, the warning shows the affected path and attribute, and the result is “Completed with warnings”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存先が属性に対応せず保持できなかった場合は、対象パスと属性が警告に表示され、結果は「警告ありで完了」になります。"
          }
        }
      },
      "generatesSymbol": false
    },
