          "stringUnit": {
            "state": "translated",
            "value": "Mac固有の情報の技術的な名称は「拡張属性・リソースフォーク」です。"
          }
        }
      },
      "generatesSymbol": false
    },
    "Turn this on to keep the dates of the folders themselves. When folders at the same relative path are merged, the first one in the input list supplies the dates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this on to keep the dates of the folders themselves. When folders at the same relative path are merged, the first one in the input list supplies the dates."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ自体の日付も記録として残したい場合にオンにします。同じ位置のフォルダを統合するときは、入力一覧で先にあるフォルダの日付を使います。"
          }
        }
      },
      "generatesSymbol": false
