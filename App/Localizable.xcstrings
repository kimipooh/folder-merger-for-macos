    "The technical names for Mac metadata are extended attributes and resource forks.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The technical names for Mac metadata are extended attributes and resource forks."
