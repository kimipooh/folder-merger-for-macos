    "Finalize with RENAME_EXCL only on success. Clean up the temporary folder on failure or cancellation. Unsupported attributes produce warnings; other errors stop the merge.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalize with RENAME_EXCL only on success. Clean up the temporary folder on failure or cancellation. Unsupported attributes produce warnings; other errors stop the merge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "成功時のみ RENAME_EXCL で確定。失敗・キャンセル時は一時フォルダを後片付け。属性非対応は警告で継続、それ以外は中止。"
          }
        }
      },
      "generatesSymbol": false
    },
