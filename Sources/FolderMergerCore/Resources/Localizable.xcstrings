    "Create exclusively in a temporary folder on the same volume. Apply selected attributes only: contents → extended attributes → file permissions → modification date → creation date. Apply folder attributes after their children, deepest first. The output root is newly created.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create exclusively in a temporary folder on the same volume. Apply selected attributes only: contents → extended attributes → file permissions → modification date → creation date. Apply folder attributes after their children, deepest first. The output root is newly created."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同一ボリュームの一時フォルダに排他的に作成。選択した属性のみ適用: 内容 → 拡張属性 → ファイル権限 → 変更日 → 作成日。フォルダ属性は子の完了後、深い順。出力ルートは新規作成。"
          }
        }
      },
      "generatesSymbol": false
    },
    "Created folder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
