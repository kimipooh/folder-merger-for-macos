    "Inputs remain unchanged and nothing is overwritten. Contents are compared byte by byte; identical files at the same relative path are deduplicated. File and folder attributes come from the first input.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inputs remain unchanged and nothing is overwritten. Contents are compared byte by byte; identical files at the same relative path are deduplicated. File and folder attributes come from the first input."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力不変・非上書き。内容はバイト比較し、同一相対パスの同一ファイルを1件にまとめ、ファイル・フォルダの属性は先頭入力から採用。"
          }
        }
      },
      "generatesSymbol": false
    },
