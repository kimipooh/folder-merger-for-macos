    },
    "Inputs remain unchanged and nothing is overwritten. Same-path folders are merged, including canonical Unicode equivalents when the destination treats them as identical. The first spelling and folder attributes are kept. Identical files are deduplicated; file attributes come from the selected file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inputs remain unchanged and nothing is overwritten. Same-path folders are merged, including canonical Unicode equivalents when the destination treats them as identical. The first spelling and folder attributes are kept. Identical files are deduplicated; file attributes come from the selected file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力を変更せず、既存項目を上書きしません。同じ相対パスのフォルダは統合します。Unicode の正準等価な名前も保存先が同一視する場合は統合します。表記とフォルダ属性は先の入力を使います。同一内容のファイルは省略し、ファイル属性は採用したファイルから取得します。"
          }
        }
      },
      "extractionState": "manual",
      "generatesSymbol": false
    },
    "Apply the selected rule only to different file contents. Newer-file priority stops on equal or incomparable modification dates. Stop on file/folder conflicts or other destination name collisions. Exclude .DS_Store at every level.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply the selected rule only to different file contents. Newer-file priority stops on equal or incomparable modification dates. Stop on file/folder conflicts or other destination name collisions. Exclude .DS_Store at every level."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が異なるファイルにだけ選択したルールを適用します。新しい方を優先する場合、変更日時が同じ、または比較不可なら中止します。ファイルとフォルダの衝突やその他の保存先での名前衝突は中止します。.DS_Store は全階層で除外します。"
          }
        }
      },
      "extractionState": "manual",
      "generatesSymbol": false
    },
